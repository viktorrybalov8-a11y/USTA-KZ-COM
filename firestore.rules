rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && (request.auth.token.get('email_verified', false) == true
          || request.auth.token.get('phone_number', null) != null);
    }

    function validContactPhone(phone) {
      return phone is string && phone.matches('^\\+[0-9]{10,15}$');
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    function isManager() {
      return request.auth != null
        && request.auth.token.get('manager', false) == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('enabled', false) == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') == 'manager';
    }

    function validProfile(data, uid) {
      return data.uid == uid
        && validContactPhone(data.phone)
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 80
        && data.city is string
        && data.city.size() >= 2
        && data.city.size() <= 80
        && data.role in ['customer', 'master', 'company']
        && data.services is list
        && data.services.size() <= 10;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'phone', 'city', 'role', 'createdAt', 'updatedAt', 'services', 'photoUrl'
        ])
        && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.role == resource.data.role
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.city.size() <= 80
        && request.resource.data.services is list
        && request.resource.data.services.size() <= 10
        && (!('photoUrl' in request.resource.data) || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 2048))
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'phone', 'city', 'role', 'createdAt', 'updatedAt', 'services', 'photoUrl'
        ]);
      allow delete: if signedIn() && request.auth.uid == uid;

      match /devices/{tokenId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'platform', 'createdAt', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 20
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform in ['android', 'ios', 'web'];
      }
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'city', 'role', 'services', 'createdAt', 'updatedAt', 'photoUrl'
        ])
        && request.resource.data.role in ['customer', 'master', 'company']
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.city.size() <= 80
        && request.resource.data.services is list
        && request.resource.data.services.size() <= 10
        && (!('photoUrl' in request.resource.data) || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 2048))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.city.size() <= 80
        && request.resource.data.services is list
        && request.resource.data.services.size() <= 10
        && (!('photoUrl' in request.resource.data) || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 2048))
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'city', 'role', 'services', 'createdAt', 'updatedAt', 'photoUrl'
        ]);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /jobs/{jobId} {
      allow read: if signedIn() && (resource.data.status == 'published' || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validContactPhone(request.resource.data.phone)
        && request.resource.data.status == 'published'
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 70
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.city.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 3
        && request.resource.data.description.size() <= 1000
        && request.resource.data.budget is int
        && request.resource.data.budget >= 0
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 4
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'id', 'title', 'category', 'city', 'phone', 'description', 'budget',
          'createdAt', 'ownerId', 'imageUrls', 'status'
        ]);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && validContactPhone(request.resource.data.phone)
        && request.resource.data.status in ['published', 'closed']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 70
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.city.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 3
        && request.resource.data.description.size() <= 1000
        && request.resource.data.budget is int
        && request.resource.data.budget >= 0
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 4
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly([
          'id', 'title', 'category', 'city', 'phone', 'description', 'budget',
          'createdAt', 'ownerId', 'imageUrls', 'status'
        ]);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.lastMessage == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'participants', 'createdAt', 'updatedAt', 'lastMessage'
        ]);
      allow update: if signedIn()
        && resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'participants', 'createdAt', 'updatedAt', 'lastMessage', 'lastSenderId'
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        function conversationMember() {
          return signedIn() && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        }
        allow read: if conversationMember();
        allow create: if conversationMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt']);
        allow update, delete: if false;
      }
    }

    match /serviceRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.phone == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone
        && validContactPhone(request.resource.data.phone)
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.type == 'advertising'
        && request.resource.data.company is string
        && request.resource.data.company.size() >= 2
        && request.resource.data.company.size() <= 100
        && request.resource.data.placement in ['Баннер в приложении', 'Карточка в каталоге', 'Рассылка пользователям']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 1000
        && request.resource.data.keys().hasOnly(['ownerUid', 'phone', 'type', 'company', 'placement', 'message', 'status', 'createdAt']);
      allow read: if signedIn() && (isAdmin() || isManager() || resource.data.ownerUid == request.auth.uid);
      allow update: if (isAdmin() || isManager())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'in_progress', 'done', 'rejected']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /notifications/{uid}/items/{notificationId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
